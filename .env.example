# Copy this file to .env and fill it in. Never commit .env.
# "Needed" lines must be filled. Everything else is optional.

# --- Needed ---
# Your Agent37 API key (agent37.com dashboard, API keys).
AGENT37_API_KEY=
# Postgres link from Supabase: Project settings, Database, Connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Filled in for you by "python setup.py" ---
# The id of your Agent37 box.
AGENT37_INSTANCE=
# The id of the 30 minute recap timer. If empty, the recap step is skipped.
CRON_ID=

# --- Where the agent talks to you. Pick one or more, comma separated. ---
# screen (default, nothing sent), telegram (tested), whatsapp, slack, discord (the last three are NOT tested live)
# Leave empty for "screen": the demo needs no messaging app at all.
OUTPUT=
# telegram: token from @BotFather, and your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# whatsapp through Twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# WHATSAPP_FROM=+14155550100
# WHATSAPP_TO=+14155550101
# slack: an incoming webhook URL
# SLACK_WEBHOOK_URL=
# discord: a channel webhook URL
# DISCORD_WEBHOOK_URL=

# --- Optional ---
# If set, OpenAI reads the transcript. If empty, the Agent37 box does it.
OPENAI_API_KEY=
# A few lines about you, so the agent knows who is who. (Or put them in context.txt.)
CONTEXT=
# A label for this event.
EVENT_NAME=My event
# If set, /api/ingest needs the header X-Token with this value.
INGEST_TOKEN=
# Port for the web server.
PORT=8790
